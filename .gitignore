mobile-app/dist/
mobile-app/dist-standalone/
mobile-app/coverage/
mobile-app/playwright-report/
mobile-app/test-results/
mobile-app/.vite/

# Mosquitto broker — secrets et état runtime
infrastructure/mosquitto/config/passwd
infrastructure/mosquitto/config/acl
infrastructure/mosquitto/data/*
!infrastructure/mosquitto/data/.gitkeep
infrastructure/mosquitto/log/*
!infrastructure/mosquitto/log/.gitkeep
